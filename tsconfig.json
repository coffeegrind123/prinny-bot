{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for IndexedDB's types, which the crypto store needs. The
    // runtime comes from `fake-indexeddb`; TypeScript only ships the
    // declarations as part of DOM.
    "lib": ["ES2023", "DOM"],
    // TypeScript 6 stopped auto-including every `@types/*` package it can
    // find; without this, `Buffer` and the `node:*` modules resolve to nothing
    // and every test file fails with TS2591.
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"]
}
