# Copy to .env and fill in.

MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER_ID=@helper:example.org

# Start once with a password: it mints an access token AND bootstraps
# cross-signing, which needs user-interactive auth. Without cross-signing the
# bot's device is excluded from megolm key sharing and it silently cannot
# decrypt anything.
MATRIX_PASSWORD=

# After the first run, use the token the bot printed and drop the password.
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=

# Who owns the bot. Set this — without it the bot refuses every message, and
# enabling bootstrap instead lets whoever finds the MXID first claim it.
MATRIX_OWNER=@you:example.org
