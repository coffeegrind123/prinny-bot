{
  "name": "@prinny/bot",
  "version": "0.1.0",
  "description": "Telegram-style bot framework for Matrix — slash command menus, inline keyboards, callback queries and reply keyboards, with plain-text fallback for clients that don't support them",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeegrind123/prinny-bot.git"
  },
  "homepage": "https://github.com/coffeegrind123/prinny-bot#readme",
  "bugs": "https://github.com/coffeegrind123/prinny-bot/issues",
  "keywords": [
    "matrix",
    "bot",
    "telegram",
    "inline-keyboard",
    "callback-query",
    "prinny",
    "cinny"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "files": [
    "dist",
    "spec",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test examples --ext .ts",
    "lint:fix": "eslint src test examples --ext .ts --fix",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "fake-indexeddb": "^6.2.5",
    "marked": "^18.0.9",
    "matrix-js-sdk": "^41.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
